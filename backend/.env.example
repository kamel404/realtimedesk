# While the API runs on your machine, use localhost.
# When the API runs inside Docker (Phase 8), use the service names: postgres / redis.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/support_desk
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
PORT=4000
FRONTEND_URL=http://localhost:3000
